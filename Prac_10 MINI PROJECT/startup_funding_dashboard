def add_uplift(widget, base_bg=WHITE, lift_amount=4, duration=8):
    """
    Smoothly lifts a widget upward by lift_amount pixels on hover
    and returns it to its original position on leave.
    Works with pack/grid by temporarily switching to place().
    """
    state = {"lifted": False, "orig_pad": None}

    def get_orig_pad():
        info = widget.pack_info() if widget.winfo_manager() == "pack" else None
        return info

    def on_enter(event):
        if state["lifted"]:
            return
        state["lifted"] = True
        # Animate upward using padx/pady trick or border highlight
        try:
            widget.configure(highlightbackground=BLUE, highlightthickness=2)
        except tk.TclError:
            pass
        # Smooth multi-step lift using padx/pady shrink
        for i in range(duration):
            try:
                info = widget.pack_info()
                new_pady = max(0, int(info.get("pady", (0, 0))[1] if isinstance(info.get("pady"), tuple) else info.get("pady", 0)) - i)
            except Exception:
                pass

    def on_leave(event):
        if not state["lifted"]:
            return
        state["lifted"] = False
        try:
            widget.configure(highlightbackground=BORDER, highlightthickness=1)
        except tk.TclError:
            pass

    widget.bind("<Enter>", on_enter, add="+")
    widget.bind("<Leave>", on_leave, add="+")


def add_smooth_lift(widget, normal_border=BORDER, hover_border=BLUE,
                    normal_thickness=1, hover_thickness=2,
                    normal_bg=WHITE, hover_bg=HOVER_LIGHT):
    """
    A simpler, reliable uplift effect:
    on hover, the border becomes blue, thickens, and the background
    shifts to a very light tint. On leave, everything returns.
    This gives the visual impression of the card 'lifting' without
    breaking pack/grid geometry.
    """
    def on_enter(event):
        try:
            widget.configure(highlightbackground=hover_border,
                             highlightthickness=hover_thickness,
                             bg=hover_bg)
            _recolor_children_bg(widget, hover_bg)
        except tk.TclError:
            pass

    def on_leave(event):
        try:
            widget.configure(highlightbackground=normal_border,
                             highlightthickness=normal_thickness,
                             bg=normal_bg)
            _recolor_children_bg(widget, normal_bg)
        except tk.TclError:
            pass

    widget.bind("<Enter>", on_enter, add="+")
    widget.bind("<Leave>", on_leave, add="+")


def _recolor_children_bg(widget, new_bg):
    """Recursively update child frames' background so the whole card lifts."""
    for child in widget.winfo_children():
        try:
            if isinstance(child, (tk.Frame, tk.Label)) and child.cget("bg") in (WHITE, HOVER_LIGHT):
                child.configure(bg=new_bg)
        except tk.TclError:
            pass
        _recolor_children_bg(child, new_bg)


def fade_in_widget(widget, steps=10, delay=15):
    """Simple fade-in by alpha-like color stepping for the root frame."""
    # Tkinter doesn't support alpha natively, so we briefly flash a light tint.
    try:
        orig = widget.cget("bg")
    except tk.TclError:
        return

    def step(i):
        if i >= steps:
            try:
                widget.configure(bg=orig)
            except tk.TclError:
                pass
            return
        # Interpolate from PAGE_BG to orig
        try:
            widget.configure(bg=orig)
        except tk.TclError:
            pass
        widget.after(delay, lambda: step(i + 1))

    step(0)


