def chart_box(parent, title):
    """Chart container with uplift animation on hover."""
    box = tk.Frame(parent, bg=WHITE, highlightbackground=BORDER,
                   highlightthickness=1, cursor="hand2")
    box.pack_propagate(False)
    tk.Label(box, text=title, font=("Segoe UI", 15, "bold"),
             fg=NAVY, bg=WHITE).pack(anchor="w", padx=25, pady=(20, 5))

    # ---- Uplift animation ----
    add_smooth_lift(box, normal_border=BORDER, hover_border=BLUE,
                    normal_thickness=1, hover_thickness=2,
                    normal_bg=WHITE, hover_bg=HOVER_LIGHT)
    return box


def embed_figure(box, fig):
    canvas = FigureCanvasTkAgg(fig, master=box)
    canvas.draw()
    widget = canvas.get_tk_widget()
    widget.pack(fill="both", expand=True, padx=15, pady=(5, 15))
    plt.close(fig)


def style_axes(ax):
    ax.tick_params(axis="both", labelsize=10, colors=MUTED)
    ax.grid(False)
    for spine in ax.spines.values():
        spine.set_visible(False)


