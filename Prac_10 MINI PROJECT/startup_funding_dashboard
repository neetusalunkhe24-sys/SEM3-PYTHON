def money_short(value):
    if pd.isna(value):
        return "N/A"
    value = float(value)
    if abs(value) >= 1_000_000_000:
        return f"${value / 1_000_000_000:.2f} B"
    if abs(value) >= 1_000_000:
        return f"${value / 1_000_000:.2f} M"
    if abs(value) >= 1_000:
        return f"${value / 1_000:.1f} K"
    return f"${value:,.0f}"


